# ==========================================
# TaskFlow Environment Configuration Template
# Copy this file to .env (or backend/.env / frontend/.env.local)
# Do NOT put real secrets in this file.
# ==========================================

# ------------------------------------------
# Backend Settings
# ------------------------------------------
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="TaskFlow API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
SECRET_KEY="temporary-insecure-secret-key-change-in-production"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database connection string
# Local SQLite fallback for instant zero-dependency development:
DATABASE_URL="sqlite:///./taskflow.db"
# PostgreSQL connection for Docker or production:
# DATABASE_URL="postgresql+psycopg2://taskflow_user:taskflow_password@localhost:5432/taskflow_db"

# ------------------------------------------
# Frontend Settings
# ------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="TaskFlow"
